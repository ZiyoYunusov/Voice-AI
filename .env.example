# --- Язык и голос бота ---
# uz — узбекский (uz-UZ), ru — русский (ru-RU)
BOT_LANGUAGE=ru

# --- LLM провайдер ---
# gemini (по умолчанию, бесплатный тариф) или anthropic
LLM_PROVIDER=gemini

# Модель Gemini (Google AI Studio, ключ ниже). gemini-3.5-flash-lite — самая
# щедрая по бесплатному лимиту (RPM/RPD) на сентябрь 2026: новейшая gemini-3.6-flash
# формально тоже бесплатна, но её квота на free-тарифе намного жёстче (пара
# десятков запросов в день) и быстро ловит 429 уже на первом звонке. Если
# начнёт ловить 429 — проверь актуальную квоту на aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=

# Модель Claude (используется только если LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# --- Azure Speech (STT + TTS), бесплатный тариф F0 ---
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=

# Голоса Azure Neural TTS. Женские по умолчанию; мужские варианты в комментарии.
AZURE_VOICE_RU=ru-RU-SvetlanaNeural
# AZURE_VOICE_RU=ru-RU-DmitryNeural
AZURE_VOICE_UZ=uz-UZ-MadinaNeural
# AZURE_VOICE_UZ=uz-UZ-SardorNeural

# --- Django API для создания заказов ---
# Если не задано — работает mock-режим на data/menu.json, заказы только логируются.
DJANGO_API_URL=
DJANGO_API_TOKEN=
